listen_addresses = '*'
data_directory = '/var/lib/postgresql/data'
shared_buffers = {{ ansible_memtotal_mb * 0.25 | int }}MB
effective_cache_size = {{ ansible_memtotal_mb * 0.65 | int }}MB
work_mem = 16MB
maintenance_work_mem = 512MB
wal_level = replica
max_wal_size = 4GB
archive_mode = on
archive_command = 'wal-g wal-push %p'
